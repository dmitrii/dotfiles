[user]
	name = Dmitrii Calzago
{{- if eq .chezmoi.os "darwin" }}
	signingkey = {{ .chezmoi.homeDir }}/.ssh/id_ed25519.pub
[gpg]
	format = ssh
[gpg "ssh"]
	allowedSignersFile = {{ .chezmoi.homeDir }}/.ssh/allowed_signers
[commit]
	gpgsign = true
[tag]
	gpgsign = true
{{- /* Remote boxes have no GitHub SSH key, and this rewrite would turn every public
       HTTPS clone, including chezmoi's own pulls, into a permission error. */}}
[url "git@github.com:"]
	insteadOf = https://github.com/
[diff]
	tool = vscode
[difftool "vscode"]
	cmd = code --wait --diff $LOCAL $REMOTE
{{- end }}
[include]
	path = ~/.config/git/local.gitconfig
