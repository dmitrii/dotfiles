# sshd runs this on every login, through the login shell. Point a fixed path at this
# connection's forwarded agent, so tmux, hc terminals and background agents use it.
if [ -S "$SSH_AUTH_SOCK" ] && [ "$SSH_AUTH_SOCK" != "$HOME/.ssh/agent.sock" ]; then
    ln -sf "$SSH_AUTH_SOCK" "$HOME/.ssh/agent.sock"
fi
